      "summary": "Median extraction time is higher that 3 minutes"
    },
    "condition": "A",
    "data": [
      {
        "datasourceUid": "b02f26ef-79d6-4a0e-aa7e-218708cee7a2",
        "model": {
          "datasource": {
            "type": "postgres",
            "uid": "b02f26ef-79d6-4a0e-aa7e-218708cee7a2"
          },
          "editorMode": "code",
          "format": "table",
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "rawQuery": true,
          "rawSql": "WITH time_series AS (\r\n  SELECT\r\n    GENERATE_SERIES(\r\n      $__timeFrom() :: timestamp,\r\n      $__timeTo() :: timestamp,\r\n      '5 min' :: interval\r\n    ) AS date_time\r\n),\r\nevents_data AS (\r\n  SELECT\r\n    DATE_BIN('5 min', date_time, '2000-1-1') AS time,\r\n    PERCENTILE_CONT(0.5) WITHIN GROUP (\r\n      ORDER BY\r\n        CAST(value AS DECIMAL(10, 3))\r\n    ) AS median\r\n  FROM\r\n    metrics.events\r\n  WHERE\r\n    event = 'saga_processing_time'\r\n    AND $__timeFilter(date_time)\r\n    AND org IN ('aerospheres','arla','danfoss','document_demo','emco','fritzschur','ga_demo','ga_review','gianlucas','goa_qa','goautonomous','gotestorg','grundfos','hempel','ifm','jde','kamstrup','kimbrer','klee','leki','leki_demo','mediq','ml','mom','momtex','nilfisk','rockwool','stark','test','topcast','tpaerospace','velux','wesco')\r\n    AND intent IN ('request_simple_order')\r\n    AND (\r\n      (\r\n        'Production' IN ('Production')\r\n        AND (\r\n          is_qa IS NULL\r\n          OR is_qa = FALSE\r\n        )\r\n      )\r\n      OR (\r\n        'Quality Assurance' IN ('Production')\r\n        AND is_qa = TRUE\r\n      )\r\n    )\r\n  GROUP BY\r\n    time\r\n)\r\nSELECT\r\n  date_time,\r\n  COALESCE(median, 0) AS median\r\nFROM\r\n  time_series\r\n  LEFT JOIN events_data ON DATE_BIN('5 min', date_time, '2000-1-1') = time\r\nWHERE\r\n  'median' IN ('median','p90')\r\nORDER BY\r\n  date_time;",
          "refId": "median",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        },
        "queryType": "",
        "refId": "median",
        "relativeTimeRange": {
          "from": 86400,
          "to": 0
        }
      },
      {
        "datasourceUid": "b02f26ef-79d6-4a0e-aa7e-218708cee7a2",
        "model": {
          "datasource": {
