          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "intervalMs": 60000,
          "maxDataPoints": 43200,
          "rawQuery": true,
          "rawSql": "WITH time_series AS (\n  SELECT\n    GENERATE_SERIES(\n      $__timeFrom() :: timestamp,\n      $__timeTo() :: timestamp,\n      '5 min' :: interval\n    ) AS date_time\n),\nevents_data AS (\n  SELECT\n    DATE_BIN('5 min', date_time, '2000-1-1') AS time,\n    COUNT(value) AS count\n  FROM\n    metrics.events\n  WHERE\n    event = 'saga_processing_time'\n    AND $__timeFilter(date_time)\n    AND org IN ('aerospheres','arla','danfoss','document_demo','emco','fritzschur','ga_demo','ga_review','gianlucas','goa_qa','goautonomous','gotestorg','grundfos','hempel','ifm','jde','kamstrup','kimbrer','klee','leki','leki_demo','mediq','ml','mom','momtex','nilfisk','rockwool','stark','test','topcast','tpaerospace','velux','wesco')\n    AND intent IN ('request_simple_order')\n    AND (\n      (\n        'Production' IN ('Production')\n        AND (\n          is_qa IS NULL\n          OR is_qa = FALSE\n        )\n      )\n      OR (\n        'Quality Assurance' IN ('Production')\n        AND is_qa = TRUE\n      )\n    )\n  GROUP BY\n    time\n)\nSELECT\n  date_time,\nCOALESCE(count, 0)AS count\nFROM\n  time_series\n  LEFT JOIN events_data ON DATE_BIN('5 min', date_time, '2000-1-1') = time\nWHERE\n  'median' IN ('median','p90')\nORDER BY\n  date_time;",
          "refId": "count",
