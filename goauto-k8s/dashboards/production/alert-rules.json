          "range": true,
          "rawQuery": true,
          "rawSql": "SELECT\n  org_id,\n  EXTRACT(EPOCH FROM (NOW() - MIN(created_at))) AS delay_seconds\nFROM\n  bc.mail_envelope me\nWHERE\n  org_id NOT LIKE '%\\_shadow%'\n  AND created_at >= NOW() - INTERVAL '1 hours'\n  AND NOT EXISTS (\n    SELECT 1\n    FROM bc.events e\n    WHERE e.mail_envelope_id = me.mail_envelope_id\n      AND e.event_type = 'process_completed'\n  )\n  AND status = 'processing'\nGROUP BY \n  org_id\nHAVING \n  NOW() - MIN(created_at) > INTERVAL '0 seconds'\n  -- AND NOW() - MIN(created_at) < INTERVAL '1 day'\nORDER BY \n  delay_seconds DESC;",
